PORT=3000
BASE_URL=http://localhost:3000
ADMIN_KEY=choose-a-long-random-password
# Optional. Without this, checkout uses the demo cashier at /pay.html
PAYSTACK_SECRET_KEY=
# Optional. Without this, orders are stored in data/store.json
DATABASE_URL=
# Optional email (reminders + receipts). Gmail: host smtp.gmail.com, port 465, use an App Password
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=JTC <you@example.com>
